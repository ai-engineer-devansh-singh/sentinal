# ── SENTINEL configuration ──────────────────────────────────────────────
# Copy to .env and fill in. The app runs fully without a key (deterministic
# local-reasoning fallback) so the demo always works; set the key to get real
# Grok deliberation from the 4 agents + orchestrator.

# xAI Grok API key (https://console.x.ai). Leave blank to use local fallback.
XAI_API_KEY=

# xAI OpenAI-compatible endpoint. Default works for the public xAI API.
XAI_BASE_URL=https://api.x.ai/v1

# Grok model used for agent reasoning + orchestrator deliberation.
# Options: grok-4, grok-4-fast, grok-3, grok-3-mini, grok-beta
XAI_MODEL=grok-4-fast

# Larger model the Carbon Budget Controller escalates to for hard cases.
XAI_MODEL_LARGE=grok-4

# Demo pacing: 1 real second = N simulated minutes. 1.0 => Karen's 90-min
# case unfolds in 90 seconds.
DEMO_SPEED=1.0
DEMO_HOST=0.0.0.0
DEMO_PORT=8000

# If "1", the simulator auto-connects all device patches on startup so data
# is already flowing when you open the dashboard. Set "0" to require clicking
# "Connect patch" per patient (matches the video narrative).
DEMO_AUTOCONNECT=1